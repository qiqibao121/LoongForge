purpose=precision_first_not_a800_speed
parent_experiment=/raid0/fastwam/experiments/pi05_powersgd_plus_acp_resume_a800_100_1000_v2
source_step100=/raid0/fastwam/experiments/pi05_powersgd_plus_acp_resume_a800_100_1000_v2/warmup_0_100/checkpoints/steps_100
uninterrupted_reference=/raid0/fastwam/experiments/pi05_powersgd_plus_acp_resume_a800_100_1000_v2/selected/baseline/metrics.jsonl
shared_checkpoint_step=300
target_step=1000
hook_start_iter_after_resume=2
first_compressed_update_step=303
first_potentially_affected_loss_step=304
lr_schedule=cosine_with_min_lr
lr_decay_iters=1000
seed=42
dtype=bfloat16
zero_optimizer=true
zero_parameters_as_bucket_view=true
standard_rank=1
min_compression_rate=4.0
restart_period=50
restart_method=approximate
oracle_candidate_ranks=1\,2\,4\,8
oracle_relative_error_budget=0.05
oracle_uses_dense_allreduce=true
oracle_sensitive_parameter_patterns=\(\^\|\\.\)\(action_\(in\|out\)_proj\|time_mlp_\(in\|out\)\)\\.
accordion_detection_window=50
accordion_relative_change_threshold=0.5
accordion_dense_protection_steps=25
adam_state_log_interval=25
failure_policy=retry_once_then_record_and_continue
